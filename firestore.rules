rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function pairId(firstUid, secondUid) {
      return firstUid < secondUid
          ? firstUid + '_' + secondUid
          : secondUid + '_' + firstUid;
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/friendRequests/$(requestId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function friendPath(uid, friendUid) {
      return /databases/$(database)/documents/users/$(uid)/friends/$(friendUid);
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/publicProfiles/$(uid);
    }

    function validFriendLimit(userData) {
      return userData.friendCount >= 0 &&
          (userData.isPro == true || userData.friendCount <= 5);
    }

    function isProfileUpdate(uid) {
      return request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'experienceStartDate']) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.friendCode == resource.data.friendCode &&
          request.resource.data.isPro == resource.data.isPro &&
          request.resource.data.get('friendCount', 0) ==
              resource.data.get('friendCount', 0);
    }

    function validProfileCustomization(customization) {
      return customization is map &&
          customization.keys().hasOnly(['titleId', 'themeId']) &&
          customization.titleId in [
            'none', 'consistent', 'completedToday', 'strengthLover',
            'runningLover', 'shareFitPro'
          ] &&
          customization.themeId in ['default', 'pink', 'yellow', 'mint'];
    }

    function profileTitleFor(userData) {
      return 'profileCustomization' in userData
          ? userData.profileCustomization.titleId
          : 'none';
    }

    function profileThemeFor(userData) {
      return 'profileCustomization' in userData
          ? userData.profileCustomization.themeId
          : 'default';
    }

    function isProfileCustomizationUpdate(uid) {
      return request.auth.uid == uid &&
          resource.data.isPro == true &&
          request.resource.data.isPro == true &&
          validProfileCustomization(
              request.resource.data.profileCustomization) &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['profileCustomization']);
    }

    function validNotificationPreferences(preferences) {
      return preferences is map &&
          preferences.keys().hasOnly(
              ['wakeUp', 'friendRequest', 'friendAccepted']) &&
          preferences.keys().hasAll(
              ['wakeUp', 'friendRequest', 'friendAccepted']) &&
          preferences.wakeUp is bool &&
          preferences.friendRequest is bool &&
          preferences.friendAccepted is bool;
    }

    function isNotificationPreferencesUpdate(uid) {
      return request.auth.uid == uid &&
          validNotificationPreferences(
              request.resource.data.notificationPreferences) &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['notificationPreferences']);
    }

    function validPublicStrengthSummary(summary) {
      return summary == null ||
          (summary is map &&
           summary.keys().hasOnly(
               ['bodyParts', 'completedSetCount', 'totalVolumeKg',
                'exercises']) &&
           summary.bodyParts is list &&
           summary.completedSetCount is int &&
           summary.completedSetCount >= 0 &&
           summary.totalVolumeKg is number &&
           summary.totalVolumeKg >= 0 &&
           (!('exercises' in summary) ||
            (summary.exercises is list && summary.exercises.size() <= 50)));
    }

    function publicStrengthMatchesPrivateWorkout(uid, workoutId, data) {
      return data.type != 'strength' ||
          (data.strengthSummary.exercises is list &&
           data.strengthSummary ==
               getAfter(/databases/$(database)/documents/users/$(uid)/workouts/$(workoutId)).data.strength);
    }

    function validPublicRunningSummary(summary) {
      return summary == null ||
          (summary is map &&
           summary.keys().hasOnly(
               ['distanceMeters', 'averagePaceSecondsPerKm']) &&
           summary.distanceMeters is number &&
           summary.distanceMeters >= 0 &&
           (summary.averagePaceSecondsPerKm == null ||
            summary.averagePaceSecondsPerKm is number));
    }

    function validPublicWorkout(uid, dateKey, workoutId, data) {
      return data.keys().hasOnly([
            'uid', 'workoutId', 'dateKey', 'type', 'startedAt', 'endedAt',
            'durationSeconds', 'photoUrl', 'photoCreatedAt', 'photoExpiresAt',
            'strengthSummary', 'runningSummary', 'createdAt', 'updatedAt'
          ]) &&
          data.uid == uid &&
          data.workoutId == workoutId &&
          data.dateKey == dateKey &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          data.type in ['strength', 'running'] &&
          data.startedAt is timestamp &&
          data.endedAt is timestamp &&
          data.durationSeconds is int &&
          data.durationSeconds >= 0 &&
          (data.photoUrl == null || data.photoUrl is string) &&
          (data.photoCreatedAt == null || data.photoCreatedAt is timestamp) &&
          (data.photoExpiresAt == null || data.photoExpiresAt is timestamp) &&
          validPublicStrengthSummary(data.strengthSummary) &&
          validPublicRunningSummary(data.runningSummary) &&
          (data.type == 'strength'
              ? data.strengthSummary != null && data.runningSummary == null
              : data.runningSummary != null && data.strengthSummary == null) &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
    }

    function isLegacyFriendCountMigration(uid) {
      return request.auth.uid == uid &&
          !('friendCount' in resource.data) &&
          request.resource.data.friendCount == 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['friendCount']);
    }

    function validAcceptCounterMutation(uid) {
      let mutation = request.resource.data._friendMutation;
      let friendUid = mutation.friendUid;
      let id = mutation.requestId;
      let beforeRequest = get(requestPath(id)).data;
      let afterRequest = getAfter(requestPath(id)).data;
      return mutation.type == 'accept' &&
          id == pairId(uid, friendUid) &&
          beforeRequest.status == 'pending' &&
          afterRequest.status == 'accepted' &&
          afterRequest.fromUid == beforeRequest.fromUid &&
          afterRequest.toUid == beforeRequest.toUid &&
          request.auth.uid == beforeRequest.toUid &&
          ((beforeRequest.fromUid == uid && beforeRequest.toUid == friendUid) ||
           (beforeRequest.fromUid == friendUid && beforeRequest.toUid == uid)) &&
          request.resource.data.friendCount == resource.data.friendCount + 1 &&
          validFriendLimit(request.resource.data) &&
          existsAfter(friendPath(uid, friendUid)) &&
          existsAfter(friendPath(friendUid, uid)) &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['friendCount', '_friendMutation']);
    }

    function validDeleteCounterMutation(uid) {
      let mutation = request.resource.data._friendMutation;
      let friendUid = mutation.friendUid;
      let id = mutation.requestId;
      return mutation.type == 'delete' &&
          id == pairId(uid, friendUid) &&
          request.auth.uid in [uid, friendUid] &&
          get(requestPath(id)).data.status == 'accepted' &&
          !existsAfter(requestPath(id)) &&
          exists(friendPath(uid, friendUid)) &&
          exists(friendPath(friendUid, uid)) &&
          !existsAfter(friendPath(uid, friendUid)) &&
          !existsAfter(friendPath(friendUid, uid)) &&
          request.resource.data.friendCount == resource.data.friendCount - 1 &&
          request.resource.data.friendCount >= 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['friendCount', '_friendMutation']);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.uid == uid &&
          request.resource.data.isPro == false &&
          request.resource.data.friendCount == 0 &&
          validProfileCustomization(
              request.resource.data.profileCustomization) &&
          request.resource.data.profileCustomization.titleId == 'none' &&
          request.resource.data.profileCustomization.themeId == 'default';

      allow update: if signedIn() && (
          isProfileUpdate(uid) ||
          isProfileCustomizationUpdate(uid) ||
          isNotificationPreferencesUpdate(uid) ||
          isLegacyFriendCountMigration(uid) ||
          validAcceptCounterMutation(uid) ||
          validDeleteCounterMutation(uid)
        );

      allow delete: if signedIn() && request.auth.uid == uid &&
          (!('friendCount' in resource.data) || resource.data.friendCount == 0);

      match /workouts/{workoutId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      match /fcmTokens/{tokenId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid &&
            request.resource.data.keys().hasOnly(
                ['token', 'platform', 'createdAt', 'updatedAt']) &&
            request.resource.data.token is string &&
            request.resource.data.token.size() > 0 &&
            request.resource.data.platform in [
              'android', 'ios', 'macos', 'windows', 'linux', 'web', 'fuchsia'
            ] &&
            request.resource.data.createdAt is timestamp &&
            request.resource.data.updatedAt is timestamp;
        allow update: if signedIn() && request.auth.uid == uid &&
            request.resource.data.keys().hasOnly(
                ['token', 'platform', 'createdAt', 'updatedAt']) &&
            request.resource.data.token is string &&
            request.resource.data.token.size() > 0 &&
            request.resource.data.platform in [
              'android', 'ios', 'macos', 'windows', 'linux', 'web', 'fuchsia'
            ] &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt is timestamp;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /friends/{friendUid} {
        allow read: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn() &&
            request.resource.data.friendUid == friendUid &&
            request.resource.data.requestId == pairId(uid, friendUid) &&
            get(requestPath(request.resource.data.requestId)).data.status == 'pending' &&
            getAfter(requestPath(request.resource.data.requestId)).data.status == 'accepted' &&
            request.auth.uid == get(requestPath(request.resource.data.requestId)).data.toUid &&
            existsAfter(friendPath(friendUid, uid)) &&
            getAfter(userPath(uid)).data.friendCount == get(userPath(uid)).data.friendCount + 1 &&
            getAfter(userPath(friendUid)).data.friendCount == get(userPath(friendUid)).data.friendCount + 1 &&
            validFriendLimit(getAfter(userPath(uid)).data) &&
            validFriendLimit(getAfter(userPath(friendUid)).data);

        allow update: if false;

        allow delete: if signedIn() && request.auth.uid in [uid, friendUid] &&
            resource.data.requestId == pairId(uid, friendUid) &&
            !existsAfter(friendPath(friendUid, uid)) &&
            !existsAfter(requestPath(resource.data.requestId)) &&
            getAfter(userPath(uid)).data.friendCount == get(userPath(uid)).data.friendCount - 1 &&
            getAfter(userPath(friendUid)).data.friendCount == get(userPath(friendUid)).data.friendCount - 1;
      }
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(
              ['uid', 'name', 'friendCode', 'active',
               'experienceStartDate', 'profileTitleId', 'profileThemeId',
               'updatedAt']) &&
          request.resource.data.uid == uid &&
          request.resource.data.active == true &&
          request.resource.data.name == getAfter(userPath(uid)).data.name &&
          request.resource.data.friendCode == getAfter(userPath(uid)).data.friendCode &&
          request.resource.data.get('experienceStartDate', null) ==
              getAfter(userPath(uid)).data.get('experienceStartDate', null) &&
          request.resource.data.get('profileTitleId', 'none') ==
              profileTitleFor(getAfter(userPath(uid)).data) &&
          request.resource.data.get('profileThemeId', 'default') ==
              profileThemeFor(getAfter(userPath(uid)).data);

      allow update: if signedIn() && request.auth.uid == uid &&
          (
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'experienceStartDate', 'updatedAt']) &&
             request.resource.data.name == getAfter(userPath(uid)).data.name &&
             request.resource.data.get('experienceStartDate', null) ==
                 getAfter(userPath(uid)).data.get('experienceStartDate', null)) ||
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['profileTitleId', 'profileThemeId', 'updatedAt']) &&
             getAfter(userPath(uid)).data.isPro == true &&
             validProfileCustomization(
                 getAfter(userPath(uid)).data.profileCustomization) &&
             request.resource.data.profileTitleId ==
                 getAfter(userPath(uid)).data.profileCustomization.titleId &&
             request.resource.data.profileThemeId ==
                 getAfter(userPath(uid)).data.profileCustomization.themeId)
          );

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['uid', 'active', 'createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.active == true &&
          getAfter(userPath(request.auth.uid)).data.friendCode == code;

      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /publicActivity/{uid} {
      allow get: if signedIn() &&
          (request.auth.uid == uid ||
           exists(friendPath(request.auth.uid, uid)));
      allow list: if false;

      allow create, update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly([
            'uid', 'status', 'workoutType', 'startedAt', 'endedAt',
            'durationSeconds', 'photoUrl', 'photoCreatedAt', 'photoExpiresAt',
            'lastWorkoutAt',
            'strengthSummary', 'runningSummary', 'updatedAt'
          ]) &&
          request.resource.data.uid == uid &&
          request.resource.data.status in ['workingOut', 'completed', 'idle'] &&
          request.resource.data.workoutType in ['strength', 'running'] &&
          request.resource.data.startedAt is timestamp &&
          request.resource.data.updatedAt is timestamp &&
          (request.resource.data.get('endedAt', null) == null ||
           request.resource.data.endedAt is timestamp) &&
          (request.resource.data.get('durationSeconds', null) == null ||
           request.resource.data.durationSeconds is int) &&
          (request.resource.data.get('photoUrl', null) == null ||
           request.resource.data.photoUrl is string) &&
          (request.resource.data.get('photoCreatedAt', null) == null ||
           request.resource.data.photoCreatedAt is timestamp) &&
          (request.resource.data.get('photoExpiresAt', null) == null ||
           request.resource.data.photoExpiresAt is timestamp) &&
          (request.resource.data.get('lastWorkoutAt', null) == null ||
           request.resource.data.lastWorkoutAt is timestamp);

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /publicWorkoutActivities/{uid}/days/{dateKey}/workouts/{workoutId} {
      allow read: if signedIn() &&
          (request.auth.uid == uid ||
           exists(friendPath(request.auth.uid, uid)));

      allow create: if signedIn() && request.auth.uid == uid &&
          validPublicWorkout(
              uid, dateKey, workoutId, request.resource.data) &&
          publicStrengthMatchesPrivateWorkout(
              uid, workoutId, request.resource.data);

      allow update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'photoUrl', 'photoCreatedAt', 'photoExpiresAt', 'updatedAt'
          ]) &&
          validPublicWorkout(
              uid, dateKey, workoutId, request.resource.data);

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /publicWorkoutStats/{uid}/days/{dateKey} {
      allow read: if signedIn() &&
          (request.auth.uid == uid ||
           exists(friendPath(request.auth.uid, uid)));

      allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly([
            'uid', 'dateKey', 'workoutCount', 'durationSeconds',
            'strengthVolumeKg', 'runningDistanceMeters', 'updatedAt'
          ]) &&
          request.resource.data.uid == uid &&
          request.resource.data.dateKey == dateKey &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.workoutCount is int &&
          request.resource.data.workoutCount == 1 &&
          request.resource.data.durationSeconds is int &&
          request.resource.data.durationSeconds >= 0 &&
          request.resource.data.strengthVolumeKg is number &&
          request.resource.data.strengthVolumeKg >= 0 &&
          request.resource.data.runningDistanceMeters is number &&
          request.resource.data.runningDistanceMeters >= 0 &&
          request.resource.data.updatedAt is timestamp;

      allow update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly([
            'uid', 'dateKey', 'workoutCount', 'durationSeconds',
            'strengthVolumeKg', 'runningDistanceMeters', 'updatedAt'
          ]) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.uid == uid &&
          request.resource.data.dateKey == resource.data.dateKey &&
          request.resource.data.dateKey == dateKey &&
          dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.workoutCount is int &&
          request.resource.data.durationSeconds is int &&
          request.resource.data.durationSeconds >= 0 &&
          request.resource.data.strengthVolumeKg is number &&
          request.resource.data.strengthVolumeKg >= 0 &&
          request.resource.data.runningDistanceMeters is number &&
          request.resource.data.runningDistanceMeters >= 0 &&
          request.resource.data.updatedAt is timestamp &&
          (
            (request.resource.data.workoutCount ==
                 resource.data.workoutCount + 1 &&
             request.resource.data.durationSeconds >=
                 resource.data.durationSeconds &&
             request.resource.data.strengthVolumeKg >=
                 resource.data.get('strengthVolumeKg', 0) &&
             request.resource.data.runningDistanceMeters >=
                 resource.data.get('runningDistanceMeters', 0)) ||
            (request.resource.data.workoutCount ==
                 resource.data.workoutCount - 1 &&
             request.resource.data.workoutCount >= 1 &&
             request.resource.data.durationSeconds <=
                 resource.data.durationSeconds &&
             request.resource.data.strengthVolumeKg <=
                 resource.data.get('strengthVolumeKg', 0) &&
             request.resource.data.runningDistanceMeters <=
                 resource.data.get('runningDistanceMeters', 0))
          );

      // Owners may remove an empty daily aggregate. This can only lower their
      // public ranking data and cannot be used to inflate a score.
      allow delete: if signedIn() && request.auth.uid == uid &&
          resource.data.uid == uid;
    }

    match /friendRequests/{id} {
      allow get: if signedIn() &&
          request.auth.uid in [resource.data.fromUid, resource.data.toUid];
      allow list: if signedIn() &&
          resource.data.status == 'pending' &&
          resource.data.fromUid == request.auth.uid;
      allow list: if signedIn() &&
          resource.data.status == 'pending' &&
          resource.data.toUid == request.auth.uid;

      allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(
              ['fromUid', 'toUid', 'status', 'createdAt', 'updatedAt']) &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.toUid != request.auth.uid &&
          request.resource.data.status == 'pending' &&
          id == pairId(request.resource.data.fromUid, request.resource.data.toUid) &&
          get(profilePath(request.resource.data.fromUid)).data.active == true &&
          get(profilePath(request.resource.data.toUid)).data.active == true &&
          !exists(friendPath(request.resource.data.fromUid, request.resource.data.toUid)) &&
          !exists(friendPath(request.resource.data.toUid, request.resource.data.fromUid));

      allow update: if signedIn() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.auth.uid == resource.data.toUid &&
          request.resource.data.fromUid == resource.data.fromUid &&
          request.resource.data.toUid == resource.data.toUid &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']) &&
          existsAfter(friendPath(resource.data.fromUid, resource.data.toUid)) &&
          existsAfter(friendPath(resource.data.toUid, resource.data.fromUid)) &&
          getAfter(userPath(resource.data.fromUid)).data.friendCount ==
              get(userPath(resource.data.fromUid)).data.friendCount + 1 &&
          getAfter(userPath(resource.data.toUid)).data.friendCount ==
              get(userPath(resource.data.toUid)).data.friendCount + 1 &&
          validFriendLimit(getAfter(userPath(resource.data.fromUid)).data) &&
          validFriendLimit(getAfter(userPath(resource.data.toUid)).data);

      allow delete: if signedIn() && (
          (resource.data.status == 'pending' &&
           request.auth.uid in [resource.data.fromUid, resource.data.toUid]) ||
          (resource.data.status == 'accepted' &&
           request.auth.uid in [resource.data.fromUid, resource.data.toUid] &&
           !existsAfter(friendPath(resource.data.fromUid, resource.data.toUid)) &&
           !existsAfter(friendPath(resource.data.toUid, resource.data.fromUid)) &&
           getAfter(userPath(resource.data.fromUid)).data.friendCount ==
               get(userPath(resource.data.fromUid)).data.friendCount - 1 &&
           getAfter(userPath(resource.data.toUid)).data.friendCount ==
               get(userPath(resource.data.toUid)).data.friendCount - 1)
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
